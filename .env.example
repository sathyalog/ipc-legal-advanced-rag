# Copy to .env (git-ignored) and fill in. NEVER put real keys in this file - it is committed.
# Every setting in ipc_rag/config.py can be overridden with an IPC_ prefix.

# LLM: "ollama" (local, free - default) or "anthropic" (Claude API, billed per token)
IPC_LLM_PROVIDER=ollama
# IPC_OLLAMA_MODEL=qwen2.5:7b-instruct
# IPC_ANTHROPIC_ANSWER_MODEL=claude-sonnet-5
# IPC_ANTHROPIC_JUDGE_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=sk-ant-...

# Retrieval switches (for experiments)
# IPC_USE_ROUTER=true
# IPC_USE_RERANKER=true
# IPC_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Use a Qdrant server instead of the embedded on-disk store
# IPC_QDRANT_URL=http://localhost:6333
